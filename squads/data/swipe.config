swipe_sources:
  - dashboard_examples
  - kpi_tree_examples
  - experiment_onepagers
  - cohort_reports
  - cs_qbr_examples
  - community_scorecards
  - data_storytelling
  - segmentation_reports

curation_rules:
  - real_companies_only
  - include_context_and_decision
  - tag_by_industry
  - tag_by_metric_type
  - include_what_worked_and_failed
  - never_show_vanity_without_context

quality_bar:
  min_context: true
  must_include_decision: true
  must_include_result: true
  no_vanity_without_action: true

categories:
  dashboard-examples:
    tags: [exec, growth, retention, product, cs]
    format: screenshot_or_spec + context + decision
  kpi-tree-examples:
    tags: [saas, ecommerce, marketplace]
    format: tree_visual + drivers + owners
  experiment-examples:
    tags: [onepager, analysis, kill-report]
    format: hypothesis + result + decision + learning
  cohort-examples:
    tags: [retention, activation, clv]
    format: curve + reading + action
  cs-examples:
    tags: [health-score, qbr, early-warning]
    format: model + validation + outcome
  community-examples:
    tags: [scorecard, roi-case]
    format: metrics + attribution + business_impact
  storytelling-examples:
    tags: [narrative, exec-report]
    format: insight + context + action + no_deception
  segmentation-examples:
    tags: [rfm, value-based]
    format: method + segments + actionability
